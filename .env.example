# Mock mode flags (default true for demo-first onboarding)
USE_MOCK_AUTH=true
USE_MOCK_AI=true
USE_MOCK_DATA=true
# Exposed to client components (login Google-OAuth guard, etc.)
NEXT_PUBLIC_USE_MOCK=true

# Supabase (replace with your own project URL/keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (only required if USE_MOCK_AI=false)
OPENAI_API_KEY=

# App URL (for OAuth callbacks and widget origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
